# Copy to lab.env (git-ignored) and fill in. NEVER commit real addresses, names of networks, or credentials.
# lab.env is sourced by bash: plain KEY=value lines.

# clouds.yaml entry used by the openstack CLI (the ozar-dev session has it)
OS_CLOUD=ozar-lab

# REQUIRED. Project network that ozar-dev also uses, so the worker reaches guest fixed IPs (EXP-01 Q8).
OVLM_LAB_NETWORK=
# REQUIRED. Flavor for ovlm-lab-host: at least 2 vCPU and 4 GB RAM (Docker build + PostgreSQL + api + worker).
# Pick it from `openstack flavor list`; G0.basic.1c1g is too small for this host.
OVLM_LAB_HOST_FLAVOR=
# REQUIRED. CIDR that ozar-dev connects from (security group source for SSH and the probe). Not in the repository.
OVLM_LAB_ADMIN_CIDR=
# REQUIRED. Public key file (public half only) of the operator, injected into ovlm-lab-host.
OVLM_LAB_SSH_PUBKEY_FILE=
# Private key matching it, if ssh does not find it by itself (agent or default key). Optional.
OVLM_LAB_SSH_KEY_FILE=

# The one floating IP address the maintainer set aside for the lab (the pool can be empty, EXP-01).
# Never the address ozar-dev itself uses. Used by the fip stage and as an allowed change in diff-snapshots.sh.
OVLM_LAB_FIP=

# OVLM under test: repository URL and the ref (a commit SHA is best; a branch or tag works too).
OVLM_LAB_REPO_URL=
OVLM_LAB_REF=

# Egress proxy, ONLY if the project network has no direct Internet. An operator-provided HTTPS-only proxy
# (CONNECT to port 443 only; plain HTTP refused). Plain http://host:port, no user name or password in the URL.
# The lab host uses it for apt (over HTTPS), Docker pulls and builds, git, pip; blue uses it for apt; the OVLM worker
# uses it for the OpenStack APIs only (never for SSH or the guest health probe).
# Leave empty if the VMs reach the Internet directly.
OVLM_LAB_HTTPS_PROXY=
# Extra no-proxy entries (comma separated). The subnet CIDRs of OVLM_LAB_NETWORK, loopback and the Compose service
# names are added automatically; add other guest networks or addresses the worker must reach directly.
OVLM_LAB_NO_PROXY=
# HTTPS mirrors for apt on the VMs (used only when a proxy is set).
OVLM_LAB_APT_MIRROR=https://archive.ubuntu.com/ubuntu
OVLM_LAB_APT_SECURITY_MIRROR=https://security.ubuntu.com/ubuntu

# Defaults from EXP-01 (override only if the maintainer says so)
OVLM_LAB_TARGET_FLAVOR=G0.basic.1c1g
# The exact Glance name (`openstack image list`); preflight lists look-alikes if it is not found.
OVLM_LAB_IMAGE="Ubuntu 24.04 LTS - Noble Numbat"
OVLM_LAB_VOLUME_TYPE=NVMe
OVLM_LAB_DATA_SIZE_GB=2

# Used by inject.sh and collect-evidence.sh (from ozar-dev):
#   ssh destination of the lab host, and the OVLM API reached through `ssh -L 8000:127.0.0.1:8000`
OVLM_LAB_HOST_SSH=
OVLM_URL=http://127.0.0.1:8000
OVLM_TOKEN_FILE=

# Where snapshots, evidence, probe CSVs and credentials are written (outside the repository). Default: ~/.ovlm-lab
# OVLM_LAB_WORKDIR=
