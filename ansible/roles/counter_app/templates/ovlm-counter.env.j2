# Managed by Ansible (ovlm-counter). No secrets here.
OVLM_COUNTER_DATA_DIR={{ ovlm_mount_point }}
OVLM_COUNTER_MARKER={{ ovlm_data_marker }}
OVLM_COUNTER_PORT={{ ovlm_app_port }}
OVLM_COUNTER_VOLUME_ID={{ ovlm_expected_serial }}
OVLM_COUNTER_FS_TYPE={{ ovlm_fs_type }}
{% if ovlm_test_mode | bool %}
# CI only. Never present on a real VM.
OVLM_COUNTER_TEST_MODE=1
OVLM_COUNTER_TEST_FS_UUID={{ ovlm_test_fs_uuid }}
{% endif %}
